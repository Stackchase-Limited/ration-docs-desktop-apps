<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Ration Docs.app/Contents/MacOS/Ration Docs (CEF browser process), signed by sign_and_notarize.sh.
  allow-jit:    the AI agent's document tools run CDocBuilder (doctrenderer -> JavaScriptCore)
                inside this process (desktop-sdk lib/tools/tools.cpp). Without it JSC still works,
                interpreted, several times slower.
  audio-input,  Info.plist declares NSMicrophoneUsageDescription/NSCameraUsageDescription for
  camera:       pages that call getUserMedia; under the hardened runtime TCC refuses the device
                without these, whatever the user answers.
  Deliberately absent: disable-library-validation (every binary carries our Team ID),
  allow-unsigned-executable-memory, allow-dyld-environment-variables, and get-task-allow
  (the notary service rejects it; the Xcode target's ONLYOFFICE.entitlements still has it).
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
